# =============================================================================
# GitHub Repository Analyzer — Environment Configuration
# =============================================================================
# All variables below are OPTIONAL. Copy this file to `.env` and uncomment
# only the values you want to override. Every variable has a safe default
# baked into the scripts, so an empty `.env` (or no `.env` at all) is valid.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Cloning & Resolution (scripts/clone_repo.py)
# -----------------------------------------------------------------------------

# Root directory where remote repository clones are written (and recommended
# output root for local repository reports).
# Default: /tmp/repo-analyzer
# WORK_ROOT=/tmp/repo-analyzer

# Abort local scans (or log a warning after a remote clone) if the repository
# exceeds this size in megabytes.
# Default: 500
# MAX_SIZE_MB=500

# Timeout (in seconds) applied to each individual git operation
# (clone, fetch, reset).
# Default: 120
# GIT_TIMEOUT=120

# GitHub personal access token for private HTTPS clones.
# Unset by default. Use a fine-grained token with `repo:read` scope and never
# commit it to source control. Redacted automatically from logs and errors.
# Default: unset
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Analysis Limits (scripts/analyzer.py)
# -----------------------------------------------------------------------------

# Maximum number of supported text/source files analyzed per repository.
# Files beyond this budget are counted in `summary.skipped_counts.file_budget`.
# Default: 20000
# MAX_FILES=20000
